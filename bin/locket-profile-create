#!/usr/bin/env bash
# locket profile-create - Create a new profile keypair
#
# Usage: locket profile-create <name>

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}$1${NC}"
}

info() {
    echo -e "${BLUE}$1${NC}"
}

warn() {
    echo -e "${YELLOW}$1${NC}"
}

show_help() {
    cat << 'EOF'
Usage: locket profile-create <name>

Create a new profile keypair for Locket secrets management.

Arguments:
  <name>    Name of the profile (e.g., default, desktop, server, work)

The command will:
  1. Generate a new age keypair
  2. Save the public key to secrets/profiles/<name>.pub
  3. Display the private key ONCE for you to save securely

Profile names should be descriptive and follow these conventions:
  - 'default' - secrets available on all personal machines
  - 'desktop' - secrets for GUI/desktop machines
  - 'server'  - secrets for server machines
  - 'work'    - secrets for work machines (separate from personal)
  - '<hostname>' - secrets for a specific host only

Examples:
  locket profile-create default
  locket profile-create desktop
  locket profile-create my-laptop
EOF
}

validate_profile_name() {
    local name="$1"
    
    # Check for empty name
    if [[ -z "$name" ]]; then
        error "Profile name cannot be empty"
    fi
    
    # Check for valid characters (alphanumeric, dash, underscore)
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        error "Profile name can only contain letters, numbers, dashes, and underscores"
    fi
    
    # Check for reserved names
    if [[ "$name" == "." || "$name" == ".." ]]; then
        error "Invalid profile name: '$name'"
    fi
}

main() {
    # Check for help flag
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
        show_help
        exit 0
    fi
    
    # Require profile name
    if [[ $# -lt 1 ]]; then
        error "Profile name required. Usage: locket profile-create <name>"
    fi
    
    local profile_name="$1"
    validate_profile_name "$profile_name"
    
    local pub_file="$LOCKET_PROFILES_DIR/${profile_name}.pub"
    
    # Check if profile already exists
    if [[ -f "$pub_file" ]]; then
        error "Profile '$profile_name' already exists at: $pub_file"
    fi
    
    # Check for age command
    if ! command -v age-keygen &> /dev/null; then
        error "age-keygen not found. Please install age: https://github.com/FiloSottile/age"
    fi
    
    info "Creating profile '$profile_name'..."
    echo
    
    # Generate keypair
    # age-keygen outputs the secret key to stdout and public key to stderr
    local temp_key
    temp_key=$(mktemp)
    trap "rm -f '$temp_key'" EXIT
    
    # Generate the key
    age-keygen 2>"$temp_key" | head -1 > /dev/null
    
    # Extract public and private keys
    local private_key
    local public_key
    
    # Re-generate to capture both
    local keygen_output
    keygen_output=$(age-keygen 2>&1)
    
    public_key=$(echo "$keygen_output" | grep "^age1" | head -1)
    private_key=$(echo "$keygen_output" | grep "^AGE-SECRET-KEY-" | head -1)
    
    if [[ -z "$public_key" || -z "$private_key" ]]; then
        error "Failed to generate keypair"
    fi
    
    # Save public key
    echo "$public_key" > "$pub_file"
    
    success "Profile '$profile_name' created successfully!"
    echo
    info "Public key saved to:"
    echo "  $pub_file"
    echo
    warn "============================================================"
    warn "IMPORTANT: Save this private key securely! It will not be shown again."
    warn "============================================================"
    echo
    echo "Private key for profile '$profile_name':"
    echo
    echo "  $private_key"
    echo
    info "Store this key at ~/.config/locket/keys/${profile_name}.key"
    info "on machines that should have access to '$profile_name' secrets."
    echo
    info "Example:"
    echo "  mkdir -p ~/.config/locket/keys"
    echo "  echo '$private_key' > ~/.config/locket/keys/${profile_name}.key"
    echo "  chmod 600 ~/.config/locket/keys/${profile_name}.key"
}

main "$@"
