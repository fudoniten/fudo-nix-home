#!/usr/bin/env bash
# locket check - Validate secrets directory structure
#
# Usage: locket check

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_help() {
    cat << 'EOF'
Usage: locket check

Validate the secrets directory structure for pre-commit checks.

Checks performed:
  - All .age files have corresponding .json metadata
  - All .json files have valid schema (profiles, target are required)
  - All referenced profiles exist in secrets/profiles/
  - No unencrypted sensitive files (private keys, etc.)
  - No .key files in the secrets directory

Options:
  -h, --help    Show this help message
  -v, --verbose Show all checks, not just failures

Exit codes:
  0 - All checks passed
  1 - One or more checks failed

Examples:
  locket check
  locket check --verbose
EOF
}

VERBOSE=false
ERRORS=0
WARNINGS=0

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
}

check_pass() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${GREEN}✓${NC} $1"
    fi
}

check_fail() {
    echo -e "${RED}✗${NC} $1" >&2
    ((ERRORS++)) || true
}

check_warn() {
    echo -e "${YELLOW}!${NC} $1" >&2
    ((WARNINGS++)) || true
}

main() {
    parse_args "$@"
    
    echo "Checking secrets directory..."
    echo
    
    if [[ ! -d "$LOCKET_SECRETS_DIR" ]]; then
        check_pass "No secrets directory (nothing to check)"
        exit 0
    fi
    
    local has_jq=false
    if command -v jq &> /dev/null; then
        has_jq=true
    else
        check_warn "jq not installed - some checks will be skipped"
    fi
    
    # Get list of available profiles
    local available_profiles=()
    if [[ -d "$LOCKET_PROFILES_DIR" ]]; then
        while IFS= read -r -d '' pubfile; do
            local name
            name=$(basename "$pubfile" .pub)
            available_profiles+=("$name")
        done < <(find "$LOCKET_PROFILES_DIR" -maxdepth 1 -name "*.pub" -print0 2>/dev/null)
    fi
    
    # Check 1: No .key files in secrets directory
    local key_files
    key_files=$(find "$LOCKET_SECRETS_DIR" -name "*.key" -type f 2>/dev/null || true)
    if [[ -n "$key_files" ]]; then
        check_fail "Private key files found in secrets directory:"
        echo "$key_files" | while read -r f; do
            echo "    $f"
        done
    else
        check_pass "No private keys in secrets directory"
    fi
    
    # Check 2: No unencrypted sensitive files
    local sensitive_patterns=("id_rsa" "id_ed25519" "id_ecdsa" "id_dsa" ".pem" "private" "secret")
    local found_sensitive=false
    for pattern in "${sensitive_patterns[@]}"; do
        local matches
        matches=$(find "$LOCKET_SECRETS_DIR" -name "*${pattern}*" -type f ! -name "*.age" ! -name "*.json" ! -name "*.pub" 2>/dev/null || true)
        if [[ -n "$matches" ]]; then
            if [[ "$found_sensitive" == "false" ]]; then
                check_fail "Potentially sensitive unencrypted files found:"
                found_sensitive=true
            fi
            echo "$matches" | while read -r f; do
                echo "    $f"
            done
        fi
    done
    if [[ "$found_sensitive" == "false" ]]; then
        check_pass "No unencrypted sensitive files detected"
    fi
    
    # Check 3: All .age files have corresponding .json
    local orphan_age=false
    while IFS= read -r -d '' age_file; do
        local json_file="${age_file%.age}.json"
        if [[ ! -f "$json_file" ]]; then
            if [[ "$orphan_age" == "false" ]]; then
                check_fail "Encrypted files missing metadata:"
                orphan_age=true
            fi
            echo "    $age_file (missing ${json_file})"
        fi
    done < <(find "$LOCKET_SECRETS_DIR" -name "*.age" -print0 2>/dev/null)
    if [[ "$orphan_age" == "false" ]]; then
        check_pass "All .age files have corresponding .json metadata"
    fi
    
    # Check 4: All .json files have corresponding .age
    local orphan_json=false
    while IFS= read -r -d '' json_file; do
        # Skip if in profiles directory
        if [[ "$json_file" == "$LOCKET_PROFILES_DIR"* ]]; then
            continue
        fi
        local age_file="${json_file%.json}.age"
        if [[ ! -f "$age_file" ]]; then
            if [[ "$orphan_json" == "false" ]]; then
                check_fail "Metadata files without encrypted data:"
                orphan_json=true
            fi
            echo "    $json_file (missing ${age_file})"
        fi
    done < <(find "$LOCKET_SECRETS_DIR" -name "*.json" -print0 2>/dev/null)
    if [[ "$orphan_json" == "false" ]]; then
        check_pass "All .json files have corresponding .age files"
    fi
    
    # Check 5: JSON schema validation (if jq available)
    if [[ "$has_jq" == "true" ]]; then
        local schema_errors=false
        while IFS= read -r -d '' json_file; do
            # Skip if in profiles directory
            if [[ "$json_file" == "$LOCKET_PROFILES_DIR"* ]]; then
                continue
            fi
            
            # Check valid JSON
            if ! jq empty "$json_file" 2>/dev/null; then
                if [[ "$schema_errors" == "false" ]]; then
                    check_fail "Invalid JSON files:"
                    schema_errors=true
                fi
                echo "    $json_file (invalid JSON)"
                continue
            fi
            
            # Check required fields
            local profiles target
            profiles=$(jq -r '.profiles // empty' "$json_file")
            target=$(jq -r '.target // empty' "$json_file")
            
            if [[ -z "$profiles" ]]; then
                if [[ "$schema_errors" == "false" ]]; then
                    check_fail "Missing required fields:"
                    schema_errors=true
                fi
                echo "    $json_file (missing 'profiles')"
            fi
            
            if [[ -z "$target" ]]; then
                if [[ "$schema_errors" == "false" ]]; then
                    check_fail "Missing required fields:"
                    schema_errors=true
                fi
                echo "    $json_file (missing 'target')"
            fi
            
            # Check profiles exist
            if [[ -n "$profiles" ]]; then
                local secret_profiles
                secret_profiles=$(jq -r '.profiles[]' "$json_file" 2>/dev/null || true)
                for profile in $secret_profiles; do
                    local found=false
                    for avail in "${available_profiles[@]:-}"; do
                        if [[ "$profile" == "$avail" ]]; then
                            found=true
                            break
                        fi
                    done
                    if [[ "$found" == "false" ]]; then
                        if [[ "$schema_errors" == "false" ]]; then
                            check_fail "Unknown profiles referenced:"
                            schema_errors=true
                        fi
                        echo "    $json_file references unknown profile '$profile'"
                    fi
                done
            fi
            
            # Check method value if present
            local method
            method=$(jq -r '.method // empty' "$json_file")
            if [[ -n "$method" ]] && [[ "$method" != "symlink" ]] && [[ "$method" != "copy" ]]; then
                if [[ "$schema_errors" == "false" ]]; then
                    check_fail "Invalid field values:"
                    schema_errors=true
                fi
                echo "    $json_file has invalid method '$method' (must be 'symlink' or 'copy')"
            fi
        done < <(find "$LOCKET_SECRETS_DIR" -name "*.json" -print0 2>/dev/null)
        
        if [[ "$schema_errors" == "false" ]]; then
            check_pass "All metadata files have valid schema"
            check_pass "All referenced profiles exist"
        fi
    fi
    
    # Summary
    echo
    if [[ $ERRORS -gt 0 ]]; then
        echo -e "${RED}Validation failed:${NC} $ERRORS error(s), $WARNINGS warning(s)"
        exit 1
    elif [[ $WARNINGS -gt 0 ]]; then
        echo -e "${YELLOW}Validation passed with warnings:${NC} $WARNINGS warning(s)"
        exit 0
    else
        echo -e "${GREEN}All checks passed.${NC}"
        exit 0
    fi
}

main "$@"
