#!/usr/bin/env bash
# locket add - Add a new secret
#
# Usage: locket add <user> <name> --target <path> --profiles <p1,p2,...> [options]

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}$1${NC}"
}

info() {
    echo -e "${BLUE}$1${NC}"
}

warn() {
    echo -e "${YELLOW}$1${NC}"
}

show_help() {
    cat << 'EOF'
Usage: locket add <user> <name> --target <path> --profiles <p1,p2,...> [options]

Add a new secret for a user.

Required Arguments:
  <user>                    Username (must match a user in users/ directory)
  <name>                    Secret name (alphanumeric, dashes, underscores)
  --target <path>           Target path relative to $HOME
  --profiles <p1,p2,...>    Comma-separated list of profiles

Options:
  --mode <mode>             File permissions (default: 0600)
  --method <symlink|copy>   Placement method (default: symlink)
  --description <text>      Human-readable description
  --file <path>             Read secret content from file instead of editor
  -h, --help                Show this help message

The command will:
  1. Validate all profiles exist
  2. Open $EDITOR for you to enter the secret content
  3. Encrypt the secret to all specified profile public keys
  4. Create the .age and .json files

Examples:
  # Add an SSH key (opens editor)
  locket add niten ssh-github \
    --target ".ssh/id_github" \
    --profiles default,desktop \
    --mode 0600 \
    --method copy

  # Add from file
  locket add niten api-token \
    --target ".config/myapp/token" \
    --profiles default \
    --file /path/to/token
EOF
}

# Parse command line arguments
USER_NAME=""
SECRET_NAME=""
TARGET=""
PROFILES=""
MODE="0600"
METHOD="symlink"
DESCRIPTION=""
INPUT_FILE=""

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --target)
                TARGET="$2"
                shift 2
                ;;
            --profiles)
                PROFILES="$2"
                shift 2
                ;;
            --mode)
                MODE="$2"
                shift 2
                ;;
            --method)
                METHOD="$2"
                shift 2
                ;;
            --description)
                DESCRIPTION="$2"
                shift 2
                ;;
            --file)
                INPUT_FILE="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$USER_NAME" ]]; then
                    USER_NAME="$1"
                elif [[ -z "$SECRET_NAME" ]]; then
                    SECRET_NAME="$1"
                else
                    error "Unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done
}

validate_args() {
    if [[ -z "$USER_NAME" ]]; then
        error "User name required. Usage: locket add <user> <name> --target <path> --profiles <p1,p2,...>"
    fi
    
    if [[ -z "$SECRET_NAME" ]]; then
        error "Secret name required. Usage: locket add <user> <name> --target <path> --profiles <p1,p2,...>"
    fi
    
    if [[ -z "$TARGET" ]]; then
        error "--target is required"
    fi
    
    if [[ -z "$PROFILES" ]]; then
        error "--profiles is required"
    fi
    
    # Validate secret name
    if [[ ! "$SECRET_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        error "Secret name can only contain letters, numbers, dashes, and underscores"
    fi
    
    # Validate method
    if [[ "$METHOD" != "symlink" && "$METHOD" != "copy" ]]; then
        error "Method must be 'symlink' or 'copy'"
    fi
    
    # Validate mode format
    if [[ ! "$MODE" =~ ^[0-7]{3,4}$ ]]; then
        error "Mode must be a valid octal permission (e.g., 0600, 0644)"
    fi
}

validate_profiles() {
    local missing=()
    local available=()
    
    # Get list of available profiles
    if [[ -d "$LOCKET_PROFILES_DIR" ]]; then
        while IFS= read -r -d '' pubfile; do
            local name
            name=$(basename "$pubfile" .pub)
            available+=("$name")
        done < <(find "$LOCKET_PROFILES_DIR" -maxdepth 1 -name "*.pub" -print0 2>/dev/null)
    fi
    
    # Check each requested profile
    IFS=',' read -ra PROFILE_ARRAY <<< "$PROFILES"
    for profile in "${PROFILE_ARRAY[@]}"; do
        profile=$(echo "$profile" | xargs)  # trim whitespace
        if [[ ! -f "$LOCKET_PROFILES_DIR/${profile}.pub" ]]; then
            missing+=("$profile")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}Error:${NC} The following profiles do not exist:" >&2
        for p in "${missing[@]}"; do
            echo "  - $p" >&2
        done
        echo >&2
        if [[ ${#available[@]} -gt 0 ]]; then
            echo "Available profiles:" >&2
            for p in "${available[@]}"; do
                echo "  - $p" >&2
            done
            echo >&2
        fi
        echo "To create a missing profile, run:" >&2
        echo "  locket profile-create <name>" >&2
        exit 1
    fi
}

get_secret_content() {
    local temp_file
    temp_file=$(mktemp)
    
    if [[ -n "$INPUT_FILE" ]]; then
        # Read from file
        if [[ ! -f "$INPUT_FILE" ]]; then
            rm -f "$temp_file"
            error "Input file not found: $INPUT_FILE"
        fi
        cat "$INPUT_FILE" > "$temp_file"
    else
        # Open editor
        local editor="${EDITOR:-vim}"
        
        # Add a helpful comment to the temp file
        cat > "$temp_file" << 'EOF'
# Enter your secret content below this line.
# This comment will be removed automatically.
# Save and exit to encrypt the secret.
# Exit without saving (or leave empty) to cancel.

EOF
        
        "$editor" "$temp_file"
        
        # Remove comment lines
        local content
        content=$(grep -v '^#' "$temp_file" | sed '/^$/d' || true)
        echo "$content" > "$temp_file"
    fi
    
    # Check if content is empty
    if [[ ! -s "$temp_file" ]]; then
        rm -f "$temp_file"
        error "Secret content is empty. Aborting."
    fi
    
    echo "$temp_file"
}

create_metadata() {
    local json_file="$1"
    
    # Build profiles array
    local profiles_json="["
    local first=true
    IFS=',' read -ra PROFILE_ARRAY <<< "$PROFILES"
    for profile in "${PROFILE_ARRAY[@]}"; do
        profile=$(echo "$profile" | xargs)  # trim whitespace
        if [[ "$first" == "true" ]]; then
            first=false
        else
            profiles_json+=","
        fi
        profiles_json+="\"$profile\""
    done
    profiles_json+="]"
    
    # Create JSON metadata
    cat > "$json_file" << EOF
{
  "profiles": $profiles_json,
  "target": "$TARGET",
  "mode": "$MODE",
  "method": "$METHOD",
  "description": "$DESCRIPTION"
}
EOF
}

encrypt_secret() {
    local content_file="$1"
    local output_file="$2"
    
    # Build recipient arguments
    local recipient_args=()
    IFS=',' read -ra PROFILE_ARRAY <<< "$PROFILES"
    for profile in "${PROFILE_ARRAY[@]}"; do
        profile=$(echo "$profile" | xargs)  # trim whitespace
        local pubkey
        pubkey=$(cat "$LOCKET_PROFILES_DIR/${profile}.pub")
        recipient_args+=("-r" "$pubkey")
    done
    
    # Encrypt
    if ! age "${recipient_args[@]}" -o "$output_file" "$content_file"; then
        error "Failed to encrypt secret"
    fi
}

main() {
    parse_args "$@"
    validate_args
    
    # Check for age command
    if ! command -v age &> /dev/null; then
        error "age not found. Please install age: https://github.com/FiloSottile/age"
    fi
    
    validate_profiles
    
    local user_dir="$LOCKET_SECRETS_DIR/$USER_NAME"
    local age_file="$user_dir/${SECRET_NAME}.age"
    local json_file="$user_dir/${SECRET_NAME}.json"
    
    # Check if secret already exists
    if [[ -f "$age_file" || -f "$json_file" ]]; then
        error "Secret '$SECRET_NAME' already exists for user '$USER_NAME'. Use 'locket edit' to modify it."
    fi
    
    # Create user directory
    mkdir -p "$user_dir"
    
    info "Adding secret '$SECRET_NAME' for user '$USER_NAME'..."
    echo
    
    # Get secret content
    local content_file
    content_file=$(get_secret_content)
    trap "rm -f '$content_file'" EXIT
    
    # Create metadata
    create_metadata "$json_file"
    
    # Encrypt secret
    encrypt_secret "$content_file" "$age_file"
    
    # Cleanup
    rm -f "$content_file"
    trap - EXIT
    
    echo
    success "Secret '$SECRET_NAME' created successfully!"
    echo
    info "Files created:"
    echo "  $age_file"
    echo "  $json_file"
    echo
    info "Configuration:"
    echo "  Target:   ~/$TARGET"
    echo "  Profiles: $PROFILES"
    echo "  Mode:     $MODE"
    echo "  Method:   $METHOD"
    if [[ -n "$DESCRIPTION" ]]; then
        echo "  Desc:     $DESCRIPTION"
    fi
}

main "$@"
