#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils jq
# locket remove - Remove a secret
#
# Usage: locket remove <user> <name>

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo -e "${GREEN}$1${NC}"
}

warn() {
    echo -e "${YELLOW}$1${NC}"
}

show_help() {
    cat << 'EOF'
Usage: locket remove <user> <name>

Remove a secret from the repository.

Arguments:
  <user>    Username
  <name>    Secret name

Options:
  -f, --force    Don't prompt for confirmation
  -h, --help     Show this help message

Note: This removes the encrypted files from the repository.
The decrypted secret on target hosts will remain until the next
Home Manager activation or manual cleanup.

Examples:
  locket remove niten ssh-github
  locket remove niten api-token --force
EOF
}

USER_NAME=""
SECRET_NAME=""
FORCE=false

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -f|--force)
                FORCE=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$USER_NAME" ]]; then
                    USER_NAME="$1"
                elif [[ -z "$SECRET_NAME" ]]; then
                    SECRET_NAME="$1"
                else
                    error "Unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done
}

main() {
    parse_args "$@"
    
    if [[ -z "$USER_NAME" || -z "$SECRET_NAME" ]]; then
        error "Usage: locket remove <user> <name>"
    fi
    
    local user_dir="$LOCKET_SECRETS_DIR/$USER_NAME"
    local age_file="$user_dir/${SECRET_NAME}.age"
    local json_file="$user_dir/${SECRET_NAME}.json"
    
    # Check if secret exists
    if [[ ! -f "$age_file" && ! -f "$json_file" ]]; then
        error "Secret '$SECRET_NAME' not found for user '$USER_NAME'"
    fi
    
    # Show secret info
    if [[ -f "$json_file" ]]; then
        echo "Secret: $SECRET_NAME"
        echo "User:   $USER_NAME"
        if command -v jq &> /dev/null; then
            local target profiles
            target=$(jq -r '.target' "$json_file")
            profiles=$(jq -r '.profiles | join(", ")' "$json_file")
            echo "Target: ~/$target"
            echo "Profiles: $profiles"
        fi
        echo
    fi
    
    # Confirm deletion
    if [[ "$FORCE" != "true" ]]; then
        read -p "Remove secret '$SECRET_NAME' for user '$USER_NAME'? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            exit 0
        fi
    fi
    
    # Remove files
    local removed=()
    if [[ -f "$age_file" ]]; then
        rm -f "$age_file"
        removed+=("$age_file")
    fi
    if [[ -f "$json_file" ]]; then
        rm -f "$json_file"
        removed+=("$json_file")
    fi
    
    success "Removed secret '$SECRET_NAME' for user '$USER_NAME'"
    for f in "${removed[@]}"; do
        echo "  Deleted: $f"
    done
    
    # Check if user directory is now empty
    if [[ -d "$user_dir" ]] && [[ -z "$(ls -A "$user_dir")" ]]; then
        rmdir "$user_dir"
        echo "  Removed empty directory: $user_dir"
    fi
    
    echo
    warn "Note: The decrypted secret on target hosts will remain"
    warn "until the next Home Manager activation or manual cleanup."
}

main "$@"
